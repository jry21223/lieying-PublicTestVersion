	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	configs, err := h.vulnScanService.GetScanConfigs()
	if err != nil {
		respondError(w, http.StatusInternalServerError, "获取扫描配置失败: "+err.Error())
		return
	}

	respondJSON(w, http.StatusOK, map[string]interface{}{
		"configs": configs,
	})
}

func (h *VulnScanHandler) handleGetDefaultConfig(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	config, err := h.vulnScanService.scanConfigRepo.GetDefault()
	if err != nil {
		respondError(w, http.StatusNotFound, "默认配置未找到")
		return
	}

	respondJSON(w, http.StatusOK, config)
}

func (h *VulnScanHandler) handleListPOCs(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	pocs, err := h.vulnScanService.GetPOCs()
	if err != nil {
		respondError(w, http.StatusInternalServerError, "获取POC列表失败: "+err.Error())
		return
	}

	respondJSON(w, http.StatusOK, map[string]interface{}{
		"pocs": pocs,
	})
}

func (h *VulnScanHandler) handleGenerateWAFBypassPayloads(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var req struct {
		Category string `json:"category"`
		Payload  string `json:"payload"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		respondError(w, http.StatusBadRequest, "无效的请求参数")
		return
	}

	if req.Category == "" || req.Payload == "" {
		respondError(w, http.StatusBadRequest, "请提供类别和原始Payload")
		return
	}

	payloads, err := h.vulnScanService.GenerateWAFBypassPayloads(req.Category, req.Payload)
	if err != nil {
		respondError(w, http.StatusInternalServerError, "生成WAF绕过Payload失败: "+err.Error())
		return
	}

	respondJSON(w, http.StatusOK, map[string]interface{}{
		"payloads": payloads,
	})
}
