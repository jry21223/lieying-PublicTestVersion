// SearchAssets 搜索资产
func (api *AssetAPI) SearchAssets(w http.ResponseWriter, r *http.Request) {
	targetIDStr := r.URL.Query().Get("target_id")
	keyword := r.URL.Query().Get("keyword")
	
	if targetIDStr == "" {
		api.respondError(w, http.StatusBadRequest, "目标ID不能为空")
		return
	}
	
	if keyword == "" {
		api.respondError(w, http.StatusBadRequest, "搜索关键词不能为空")
		return
	}
	
	targetID, err := uuid.Parse(targetIDStr)
	if err != nil {
		api.respondError(w, http.StatusBadRequest, "无效的目标ID")
		return
	}
	
	assets, err := api.assetRepo.Search(targetID, keyword)
	if err != nil {
		api.respondError(w, http.StatusInternalServerError, err.Error())
		return
	}
	
	api.respondJSON(w, http.StatusOK, assets)
}

// AddTags 添加标签
func (api *AssetAPI) AddTags(w http.ResponseWriter, r *http.Request, assetID uuid.UUID) {
	var req struct {
		Tags []string `json:"tags"`
	}
	
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		api.respondError(w, http.StatusBadRequest, "无效的请求")
		return
	}
	
	if err := api.assetService.AddTags(assetID, req.Tags); err != nil {
		api.respondError(w, http.StatusInternalServerError, err.Error())
		return
	}
	
	api.respondJSON(w, http.StatusOK, map[string]string{"status": "tags_added"})
}

// RemoveTags 移除标签
func (api *AssetAPI) RemoveTags(w http.ResponseWriter, r *http.Request, assetID uuid.UUID) {
	var req struct {
		Tags []string `json:"tags"`
	}
	
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		api.respondError(w, http.StatusBadRequest, "无效的请求")
		return
	}
	
	if err := api.assetService.RemoveTags(assetID, req.Tags); err != nil {
		api.respondError(w, http.StatusInternalServerError, err.Error())
		return
	}
	
	api.respondJSON(w, http.StatusOK, map[string]string{"status": "tags_removed"})
}

// GetTopologyData 获取拓扑图数据
func (api *AssetAPI) GetTopologyData(w http.ResponseWriter, r *http.Request) {
	targetIDStr := r.URL.Query().Get("target_id")
	if targetIDStr == "" {
		api.respondError(w, http.StatusBadRequest, "目标ID不能为空")
		return
	}
	
	targetID, err := uuid.Parse(targetIDStr)
	if err != nil {
		api.respondError(w, http.StatusBadRequest, "无效的目标ID")
		return
	}
	
	data, err := api.assetService.GetTopologyData(targetID)
	if err != nil {
		api.respondError(w, http.StatusInternalServerError, err.Error())
		return
	}
	
	api.respondJSON(w, http.StatusOK, data)
}

// ExportAssets 导出资产
func (api *AssetAPI) ExportAssets(w http.ResponseWriter, r *http.Request) {
	targetIDStr := r.URL.Query().Get("target_id")
	if targetIDStr == "" {
		api.respondError(w, http.StatusBadRequest, "目标ID不能为空")
		return
	}
	
	targetID, err := uuid.Parse(targetIDStr)
	if err != nil {
		api.respondError(w, http.StatusBadRequest, "无效的目标ID")
		return
	}
	
	data, err := api.assetService.ExportToJSON(targetID)
	if err != nil {
		api.respondError(w, http.StatusInternalServerError, err.Error())
		return
	}
	
	w.Header().Set("Content-Type", "application/json")
	w.Header().Set("Content-Disposition", "attachment; filename=assets.json")
	w.WriteHeader(http.StatusOK)
	w.Write([]byte(data))
}
