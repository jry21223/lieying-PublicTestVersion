func (h *EduSRCHandler) handleStartBatchScan(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	var config service.BatchScanConfig
	if err := json.NewDecoder(r.Body).Decode(&config); err != nil {
		http.Error(w, "请求参数错误", http.StatusBadRequest)
		return
	}
	
	task, err := h.eduService.StartBatchScan(&config)
	if err != nil {
		http.Error(w, "启动批量扫描失败", http.StatusInternalServerError)
		return
	}
	
