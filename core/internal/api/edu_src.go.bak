package api

import (
	"encoding/json"
	"net/http"
	"strconv"
	"strings"

	"github.com/google/uuid"
	"github.com/kunlun-sec/lunying/internal/models"
	"github.com/kunlun-sec/lunying/internal/service"
)

// EduSRCHandler 教育SRC API处理器
type EduSRCHandler struct {
	eduService *service.EduSRCService
}

func NewEduSRCServiceHandler(eduService *service.EduSRCService) *EduSRCHandler {
	return &EduSRCHandler{
		eduService: eduService,
	}
}

func (h *EduSRCHandler) RegisterRoutes(mux *http.ServeMux) {
	// 高校管理
	mux.HandleFunc("/api/edu/universities", h.handleUniversities)
	mux.HandleFunc("/api/edu/universities/", h.handleUniversity)
	mux.HandleFunc("/api/edu/provinces", h.handleProvinces)
	
	// 教务系统
	mux.HandleFunc("/api/edu/systems", h.handleEduSystems)
	mux.HandleFunc("/api/edu/fingerprints", h.handleFingerprints)
	mux.HandleFunc("/api/edu/identify", h.handleIdentify)
	
	// POC管理
	mux.HandleFunc("/api/edu/pocs", h.handleEduPOCs)
	mux.HandleFunc("/api/edu/pocs/", h.handleEduPOC)
	mux.HandleFunc("/api/edu/pocs/execute", h.handleExecutePOC)
	
	// 批量扫描
	mux.HandleFunc("/api/edu/batch-tasks", h.handleBatchTasks)
	mux.HandleFunc("/api/edu/batch-tasks/", h.handleBatchTask)
	mux.HandleFunc("/api/edu/batch-tasks/start", h.handleStartBatchScan)
	
	// 扫描结果
	mux.HandleFunc("/api/edu/scan-results", h.handleScanResults)
	mux.HandleFunc("/api/edu/scan-results/", h.handleScanResult)
	
	// SRC平台
	mux.HandleFunc("/api/edu/src-platforms", h.handleSRCPlatforms)
	mux.HandleFunc("/api/edu/src-rules", h.handleSRCRules)
	mux.HandleFunc("/api/edu/submission-templates", h.handleSubmissionTemplates)
	mux.HandleFunc("/api/edu/generate-submission", h.handleGenerateSubmission)
	
	// 挖洞技巧
	mux.HandleFunc("/api/edu/tips", h.handleHackingTips)
	mux.HandleFunc("/api/edu/tips/", h.handleHackingTip)
	mux.HandleFunc("/api/edu/tips/", h.handleTipLike)
}

// ==================== 高校管理 ====================

func (h *EduSRCHandler) handleUniversities(w http.ResponseWriter, r *http.Request) {
	switch r.Method {
	case http.MethodGet:
		h.listUniversities(w, r)
	case http.MethodPost:
		h.createUniversity(w, r)
	default:
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
	}
}

func (h *EduSRCHandler) listUniversities(w http.ResponseWriter, r *http.Request) {
	page, _ := strconv.Atoi(r.URL.Query().Get("page"))
	pageSize, _ := strconv.Atoi(r.URL.Query().Get("page_size"))
	province := r.URL.Query().Get("province")
	hasSRCStr := r.URL.Query().Get("has_src")
	
	if page <= 0 {
		page = 1
	}
	if pageSize <= 0 || pageSize > 100 {
		pageSize = 20
	}
	
	var hasSRC *bool
	if hasSRCStr != "" {
		b, _ := strconv.ParseBool(hasSRCStr)
		hasSRC = &b
	}
	
	universities, total, err := h.eduService.eduRepo.ListUniversities(page, pageSize, province, hasSRC)
	if err != nil {
		http.Error(w, "获取高校列表失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, map[string]interface{}{
		"data":  universities,
		"total": total,
		"page":  page,
		"page_size": pageSize,
	})
}

func (h *EduSRCHandler) createUniversity(w http.ResponseWriter, r *http.Request) {
	var university models.University
	if err := json.NewDecoder(r.Body).Decode(&university); err != nil {
		http.Error(w, "请求参数错误", http.StatusBadRequest)
		return
	}
	
	if err := h.eduService.eduRepo.CreateUniversity(&university); err != nil {
		http.Error(w, "创建高校失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, university)
}

func (h *EduSRCHandler) handleUniversity(w http.ResponseWriter, r *http.Request) {
	idStr := strings.TrimPrefix(r.URL.Path, "/api/edu/universities/")
	id, err := uuid.Parse(idStr)
	if err != nil {
		http.Error(w, "无效的ID", http.StatusBadRequest)
		return
	}
	
	switch r.Method {
	case http.MethodGet:
		university, err := h.eduService.eduRepo.GetUniversity(id)
		if err != nil {
			http.Error(w, "高校不存在", http.StatusNotFound)
			return
		}
		respondJSON(w, university)
	case http.MethodPut:
		var university models.University
		if err := json.NewDecoder(r.Body).Decode(&university); err != nil {
			http.Error(w, "请求参数错误", http.StatusBadRequest)
			return
		}
		university.ID = id
		if err := h.eduService.eduRepo.UpdateUniversity(&university); err != nil {
			http.Error(w, "更新高校失败", http.StatusInternalServerError)
			return
		}
		respondJSON(w, university)
	case http.MethodDelete:
		if err := h.eduService.eduRepo.DeleteUniversity(id); err != nil {
			http.Error(w, "删除高校失败", http.StatusInternalServerError)
			return
		}
		respondJSON(w, map[string]string{"message": "删除成功"})
	default:
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
	}
}

func (h *EduSRCHandler) handleProvinces(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	provinces, err := h.eduService.eduRepo.GetProvinces()
	if err != nil {
		http.Error(w, "获取省份列表失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, provinces)
}

