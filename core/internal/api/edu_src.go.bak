	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	universityIDStr := r.URL.Query().Get("university_id")
	systemType := r.URL.Query().Get("system_type")
	
	var universityID uuid.UUID
	if universityIDStr != "" {
		universityID, _ = uuid.Parse(universityIDStr)
	}
	
	systems, err := h.eduService.eduRepo.ListEduSystems(universityID, systemType)
	if err != nil {
		http.Error(w, "获取教务系统列表失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, systems)
}

