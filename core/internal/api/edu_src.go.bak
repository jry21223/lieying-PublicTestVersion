}

// ==================== 扫描结果 ====================

func (h *EduSRCHandler) handleScanResults(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	taskIDStr := r.URL.Query().Get("task_id")
	universityIDStr := r.URL.Query().Get("university_id")
	status := r.URL.Query().Get("status")
	
	var taskID, universityID uuid.UUID
	if taskIDStr != "" {
		taskID, _ = uuid.Parse(taskIDStr)
	}
	if universityIDStr != "" {
		universityID, _ = uuid.Parse(universityIDStr)
	}
	
	results, err := h.eduService.eduRepo.ListScanResults(taskID, universityID, status)
	if err != nil {
		http.Error(w, "获取扫描结果失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, results)
}

func (h *EduSRCHandler) handleScanResult(w http.ResponseWriter, r *http.Request) {
	idStr := strings.TrimPrefix(r.URL.Path, "/api/edu/scan-results/")
	id, err := uuid.Parse(idStr)
	if err != nil {
		http.Error(w, "无效的ID", http.StatusBadRequest)
		return
	}
	
	switch r.Method {
	case http.MethodGet:
		result, err := h.eduService.eduRepo.GetScanResult(id)
		if err != nil {
			http.Error(w, "结果不存在", http.StatusNotFound)
			return
		}
		respondJSON(w, result)
	case http.MethodPut:
		var result models.EduScanResult
		if err := json.NewDecoder(r.Body).Decode(&result); err != nil {
			http.Error(w, "请求参数错误", http.StatusBadRequest)
			return
		}
		result.ID = id
		if err := h.eduService.eduRepo.UpdateScanResult(&result); err != nil {
			http.Error(w, "更新失败", http.StatusInternalServerError)
			return
		}
		respondJSON(w, result)
	case http.MethodDelete:
		if err := h.eduService.eduRepo.DeleteScanResult(id); err != nil {
			http.Error(w, "删除失败", http.StatusInternalServerError)
			return
		}
		respondJSON(w, map[string]string{"message": "删除成功"})
	default:
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
	}
}

