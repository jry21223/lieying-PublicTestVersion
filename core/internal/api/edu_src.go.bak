	respondJSON(w, result)
}

// ==================== POC管理 ====================

func (h *EduSRCHandler) handleEduPOCs(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	systemType := r.URL.Query().Get("system_type")
	severity := r.URL.Query().Get("severity")
	enabledStr := r.URL.Query().Get("enabled")
	
	var enabled *bool
	if enabledStr != "" {
		b, _ := strconv.ParseBool(enabledStr)
		enabled = &b
	}
	
	pocs, err := h.eduService.eduRepo.ListEduPOCs(systemType, severity, enabled)
	if err != nil {
		http.Error(w, "获取POC列表失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, pocs)
}

func (h *EduSRCHandler) handleEduPOC(w http.ResponseWriter, r *http.Request) {
	idStr := strings.TrimPrefix(r.URL.Path, "/api/edu/pocs/")
	id, err := uuid.Parse(idStr)
	if err != nil {
		http.Error(w, "无效的ID", http.StatusBadRequest)
		return
	}
	
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	poc, err := h.eduService.eduRepo.GetEduPOC(id)
	if err != nil {
		http.Error(w, "POC不存在", http.StatusNotFound)
		return
	}
	
	respondJSON(w, poc)
}

func (h *EduSRCHandler) handleExecutePOC(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	var req struct {
		URL   string    `json:"url"`
		POCID uuid.UUID `json:"poc_id"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "请求参数错误", http.StatusBadRequest)
		return
	}
	
	poc, err := h.eduService.eduRepo.GetEduPOC(req.POCID)
	if err != nil {
		http.Error(w, "POC不存在", http.StatusNotFound)
		return
	}
	
	result, err := h.eduService.ExecutePOC(req.URL, poc)
	if err != nil {
		http.Error(w, "执行POC失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, result)
}

