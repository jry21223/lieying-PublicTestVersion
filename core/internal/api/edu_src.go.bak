func (h *EduSRCHandler) handleGenerateSubmission(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	var req struct {
		ScanResultID uuid.UUID `json:"scan_result_id"`
		TemplateID   uuid.UUID `json:"template_id"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "请求参数错误", http.StatusBadRequest)
		return
	}
	
	data, err := h.eduService.GenerateSubmission(req.ScanResultID, req.TemplateID)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, data)
}

// ==================== 挖洞技巧 ====================

func (h *EduSRCHandler) handleHackingTips(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	systemType := r.URL.Query().Get("system_type")
	vulnType := r.URL.Query().Get("vuln_type")
	category := r.URL.Query().Get("category")
	search := r.URL.Query().Get("search")
	
	tips, err := h.eduService.eduRepo.ListHackingTips(systemType, vulnType, category, search)
	if err != nil {
		http.Error(w, "获取技巧列表失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, tips)
}

func (h *EduSRCHandler) handleHackingTip(w http.ResponseWriter, r *http.Request) {
	path := r.URL.Path
	if strings.HasSuffix(path, "/like") {
		h.handleTipLike(w, r)
		return
	}
	
	idStr := strings.TrimPrefix(path, "/api/edu/tips/")
	id, err := uuid.Parse(idStr)
	if err != nil {
		http.Error(w, "无效的ID", http.StatusBadRequest)
		return
	}
	
	if r.Method != http.MethodGet {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	if err := h.eduService.eduRepo.IncrementTipViewCount(id); err != nil {
	}
	
	tip, err := h.eduService.eduRepo.GetHackingTip(id)
	if err != nil {
		http.Error(w, "技巧不存在", http.StatusNotFound)
		return
	}
	
	respondJSON(w, tip)
}

func (h *EduSRCHandler) handleTipLike(w http.ResponseWriter, r *http.Request) {
	idStr := strings.TrimSuffix(strings.TrimPrefix(r.URL.Path, "/api/edu/tips/"), "/like")
	id, err := uuid.Parse(idStr)
	if err != nil {
		http.Error(w, "无效的ID", http.StatusBadRequest)
		return
	}
	
	if r.Method != http.MethodPost {
		http.Error(w, "方法不允许", http.StatusMethodNotAllowed)
		return
	}
	
	if err := h.eduService.eduRepo.IncrementTipLikeCount(id); err != nil {
		http.Error(w, "点赞失败", http.StatusInternalServerError)
		return
	}
	
	respondJSON(w, map[string]string{"message": "点赞成功"})
}
