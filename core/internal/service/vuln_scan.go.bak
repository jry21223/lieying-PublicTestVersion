package service

import (
	"encoding/json"
	"fmt"
	"os/exec"
	"strings"
	"sync"
	"time"

	"github.com/google/uuid"
	"github.com/kunlun-sec/lunying/internal/models"
	"github.com/kunlun-sec/lunying/internal/repository"
	"gorm.io/gorm"
)

type VulnScanService struct {
	pocRepo           *repository.POCRepository
	scanConfigRepo    *repository.ScanConfigRepository
	scanTaskRepo      *repository.ScanTaskRepository
	scanResultRepo    *repository.ScanResultRepository
	vulnChainRepo     *repository.VulnerabilityChainRepository
	nucleiTemplateRepo *repository.NucleiTemplateRepository
	assetRepo         *repository.AssetRepository
	targetRepo        *repository.TargetRepository
	activeTasks       map[uuid.UUID]bool
	taskMutex         sync.RWMutex
}

func NewVulnScanService(
	pocRepo *repository.POCRepository,
	scanConfigRepo *repository.ScanConfigRepository,
	scanTaskRepo *repository.ScanTaskRepository,
	scanResultRepo *repository.ScanResultRepository,
	vulnChainRepo *repository.VulnerabilityChainRepository,
	nucleiTemplateRepo *repository.NucleiTemplateRepository,
	assetRepo *repository.AssetRepository,
	targetRepo *repository.TargetRepository,
) *VulnScanService {
	return &VulnScanService{
		pocRepo:           pocRepo,
		scanConfigRepo:    scanConfigRepo,
		scanTaskRepo:      scanTaskRepo,
		scanResultRepo:    scanResultRepo,
		vulnChainRepo:     vulnChainRepo,
		nucleiTemplateRepo: nucleiTemplateRepo,
		assetRepo:         assetRepo,
		targetRepo:        targetRepo,
		activeTasks:       make(map[uuid.UUID]bool),
	}
}

func (s *VulnScanService) InitializeDefaultData() error {
	if err := s.scanConfigRepo.InitializeDefaultConfigs(); err != nil {
		return err
	}
	return s.initializeSamplePOCs()
}

