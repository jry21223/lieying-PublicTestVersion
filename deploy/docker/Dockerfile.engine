FROM golang:1.21-alpine AS builder

WORKDIR /app

COPY engine/go.mod engine/go.sum ./
RUN go mod download

COPY engine/ .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o engine ./cmd/server

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/engine .
COPY --from=builder /app/configs ./configs

EXPOSE 8080

CMD ["./engine"]
